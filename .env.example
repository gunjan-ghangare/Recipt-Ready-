# ReceiptReady web app settings.
# Copy this file to .env in this folder (the repository root, not frontend/) and fill it in from the
# CloudFormation stack outputs after `sam deploy`. Restart `npm run dev` after changing it.
# Only VITE_* values are bundled into the browser app, so never put secrets here.
# Leave the first three empty to run the in-browser demo only.

# Stack output: ApiUrl
VITE_API_URL=

# Stack output: CognitoDomainUrl
VITE_COGNITO_DOMAIN=

# Stack output: WebClientId
VITE_COGNITO_CLIENT_ID=

# Optional. Both default to the app's own origin with a trailing slash (for example http://localhost:5173/)
# and must match one of the stack's CallbackUrls / LogoutUrls.
# VITE_COGNITO_REDIRECT_URI=http://localhost:5173/
# VITE_COGNITO_LOGOUT_URI=http://localhost:5173/

# Set to false to hide "Explore the demo".
VITE_ENABLE_DEMO=true
